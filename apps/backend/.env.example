# Required configuration. Replace example values; do not commit .env.
DATABASE_URL=postgresql://postgres:replace_database_password@localhost:5432/elms_db?schema=public
JWT_ACCESS_SECRET=replace_with_32_or_more_random_characters
JWT_REFRESH_SECRET=replace_with_another_32_random_characters
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Required only for first administrator bootstrap
# ADMIN_EMAIL=administrator@example.org
# ADMIN_PASSWORD=unique_password_at_least_12_characters
# ADMIN_NAME=System Administrator

# Independent provider-scoped secrets; never expose to the browser bundle
# ADMISSIONS_API_KEY=unique_32_character_secret
# FINANCE_API_KEY=another_unique_32_character_secret
# INTEGRATION_ACTOR_EMAIL=administrator@example.org

# Real SMTP recovery service
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_USER=provider_username
# SMTP_PASSWORD=provider_secret
# SMTP_FROM=elms@example.org

# Real SMS and WhatsApp account
# TWILIO_ACCOUNT_SID=provider_account_sid
# TWILIO_AUTH_TOKEN=provider_secret
# TWILIO_FROM=registered_sender
# TWILIO_WHATSAPP_FROM=whatsapp:registered_sender
